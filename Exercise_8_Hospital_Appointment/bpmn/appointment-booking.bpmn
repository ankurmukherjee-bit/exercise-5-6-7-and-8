<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 id="Definitions_AppointmentBooking" targetNamespace="http://bpmn.io/schema/bpmn">

 <bpmn:message id="Message_CancelBooking" name="cancel-booking"/>
 <bpmn:message id="Message_AppointmentCompleted" name="appointment-completed"/>

 <bpmn:process id="appointment-booking" name="Hospital Appointment Booking" isExecutable="true">
  <bpmn:startEvent id="Start_BookingRequested" name="Booking requested">
   <bpmn:outgoing>Flow_Start_CheckSlot</bpmn:outgoing>
  </bpmn:startEvent>

  <bpmn:businessRuleTask id="Task_CheckSlot" name="Check slot">
   <bpmn:extensionElements>
    <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotDecision"/>
   </bpmn:extensionElements>
   <bpmn:incoming>Flow_Start_CheckSlot</bpmn:incoming>
   <bpmn:outgoing>Flow_Check_Gateway</bpmn:outgoing>
  </bpmn:businessRuleTask>

  <bpmn:exclusiveGateway id="Gateway_SlotAvailable" name="Slot available?" gatewayDirection="Diverging" default="Flow_SlotFull">
   <bpmn:incoming>Flow_Check_Gateway</bpmn:incoming>
   <bpmn:outgoing>Flow_SlotAvailable</bpmn:outgoing>
   <bpmn:outgoing>Flow_SlotFull</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:serviceTask id="Task_BookSlot" name="Book slot">
   <bpmn:extensionElements>
    <zeebe:taskDefinition type="book-slot" retries="3"/>
   </bpmn:extensionElements>
   <bpmn:incoming>Flow_SlotAvailable</bpmn:incoming>
   <bpmn:outgoing>Flow_Book_Confirmation</bpmn:outgoing>
  </bpmn:serviceTask>

  <bpmn:callActivity id="Call_Confirmation" name="Send booking confirmation">
   <bpmn:extensionElements>
    <zeebe:calledElement processId="send-notification" propagateAllParentVariables="true" propagateAllChildVariables="false"/>
    <zeebe:ioMapping>
     <zeebe:input source="= patientId" target="recipientId"/>
     <zeebe:input source="= &quot;Hello &quot; + patientName + &quot;, your appointment for &quot; + department + &quot; at &quot; + preferredSlot + &quot; is confirmed.&quot;" target="messageText"/>
    </zeebe:ioMapping>
   </bpmn:extensionElements>
   <bpmn:incoming>Flow_Book_Confirmation</bpmn:incoming>
   <bpmn:outgoing>Flow_Confirmation_Wait</bpmn:outgoing>
  </bpmn:callActivity>

  <bpmn:intermediateCatchEvent id="Catch_AppointmentCompleted" name="Await appointment completion">
   <bpmn:extensionElements>
    <zeebe:subscription correlationKey="= patientId"/>
   </bpmn:extensionElements>
   <bpmn:incoming>Flow_Confirmation_Wait</bpmn:incoming>
   <bpmn:outgoing>Flow_Wait_End</bpmn:outgoing>
   <bpmn:messageEventDefinition messageRef="Message_AppointmentCompleted"/>
  </bpmn:intermediateCatchEvent>

  <bpmn:endEvent id="End_AppointmentCompleted" name="Appointment completed">
   <bpmn:incoming>Flow_Wait_End</bpmn:incoming>
  </bpmn:endEvent>

  <bpmn:callActivity id="Call_SlotFull" name="Notify slot full">
   <bpmn:extensionElements>
    <zeebe:calledElement processId="send-notification" propagateAllParentVariables="false" propagateAllChildVariables="false"/>
    <zeebe:ioMapping>
     <zeebe:input source="= patientId" target="recipientId"/>
     <zeebe:input source="= &quot;Hello &quot; + patientName + &quot;, the &quot; + department + &quot; slot at &quot; + preferredSlot + &quot; is full. Please choose another slot.&quot;" target="messageText"/>
    </zeebe:ioMapping>
   </bpmn:extensionElements>
   <bpmn:incoming>Flow_SlotFull</bpmn:incoming>
   <bpmn:outgoing>Flow_Full_End</bpmn:outgoing>
  </bpmn:callActivity>

  <bpmn:endEvent id="End_SlotUnavailable" name="Slot unavailable">
   <bpmn:incoming>Flow_Full_End</bpmn:incoming>
  </bpmn:endEvent>

  <bpmn:subProcess id="EventSub_Cancellation" name="Handle cancellation" triggeredByEvent="true">
   <bpmn:startEvent id="Start_Cancellation" name="Cancellation received" isInterrupting="true">
    <bpmn:extensionElements>
     <zeebe:subscription correlationKey="= patientId"/>
    </bpmn:extensionElements>
    <bpmn:outgoing>Flow_Cancel_Release</bpmn:outgoing>
    <bpmn:messageEventDefinition messageRef="Message_CancelBooking"/>
   </bpmn:startEvent>

   <bpmn:serviceTask id="Task_ReleaseSlot" name="Release slot">
    <bpmn:extensionElements>
     <zeebe:taskDefinition type="release-slot" retries="3"/>
    </bpmn:extensionElements>
    <bpmn:incoming>Flow_Cancel_Release</bpmn:incoming>
    <bpmn:outgoing>Flow_Release_Notify</bpmn:outgoing>
   </bpmn:serviceTask>

   <bpmn:callActivity id="Call_Cancellation" name="Send cancellation notification">
    <bpmn:extensionElements>
     <zeebe:calledElement processId="send-notification" propagateAllParentVariables="false" propagateAllChildVariables="false"/>
     <zeebe:ioMapping>
      <zeebe:input source="= patientId" target="recipientId"/>
      <zeebe:input source="= &quot;Hello &quot; + patientName + &quot;, your appointment for &quot; + department + &quot; at &quot; + preferredSlot + &quot; has been cancelled. The slot has been released.&quot;" target="messageText"/>
     </zeebe:ioMapping>
    </bpmn:extensionElements>
    <bpmn:incoming>Flow_Release_Notify</bpmn:incoming>
    <bpmn:outgoing>Flow_Cancel_End</bpmn:outgoing>
   </bpmn:callActivity>

   <bpmn:endEvent id="End_CancellationHandled" name="Cancellation handled">
    <bpmn:incoming>Flow_Cancel_End</bpmn:incoming>
   </bpmn:endEvent>

   <bpmn:sequenceFlow id="Flow_Cancel_Release" sourceRef="Start_Cancellation" targetRef="Task_ReleaseSlot"/>
   <bpmn:sequenceFlow id="Flow_Release_Notify" sourceRef="Task_ReleaseSlot" targetRef="Call_Cancellation"/>
   <bpmn:sequenceFlow id="Flow_Cancel_End" sourceRef="Call_Cancellation" targetRef="End_CancellationHandled"/>
  </bpmn:subProcess>

  <bpmn:sequenceFlow id="Flow_Start_CheckSlot" sourceRef="Start_BookingRequested" targetRef="Task_CheckSlot"/>
  <bpmn:sequenceFlow id="Flow_Check_Gateway" sourceRef="Task_CheckSlot" targetRef="Gateway_SlotAvailable"/>
  <bpmn:sequenceFlow id="Flow_SlotAvailable" name="AVAILABLE" sourceRef="Gateway_SlotAvailable" targetRef="Task_BookSlot">
   <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotDecision.slotStatus = "AVAILABLE"</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="Flow_SlotFull" name="FULL (default)" sourceRef="Gateway_SlotAvailable" targetRef="Call_SlotFull"/>
  <bpmn:sequenceFlow id="Flow_Book_Confirmation" sourceRef="Task_BookSlot" targetRef="Call_Confirmation"/>
  <bpmn:sequenceFlow id="Flow_Confirmation_Wait" sourceRef="Call_Confirmation" targetRef="Catch_AppointmentCompleted"/>
  <bpmn:sequenceFlow id="Flow_Wait_End" sourceRef="Catch_AppointmentCompleted" targetRef="End_AppointmentCompleted"/>
  <bpmn:sequenceFlow id="Flow_Full_End" sourceRef="Call_SlotFull" targetRef="End_SlotUnavailable"/>
 </bpmn:process>

 <bpmndi:BPMNDiagram id="Diagram_AppointmentBooking">
  <bpmndi:BPMNPlane id="Plane_AppointmentBooking" bpmnElement="appointment-booking">
   <bpmndi:BPMNShape id="Start_BookingRequested_di" bpmnElement="Start_BookingRequested"><dc:Bounds x="100" y="180" width="36" height="36"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Task_CheckSlot_di" bpmnElement="Task_CheckSlot"><dc:Bounds x="180" y="158" width="150" height="80"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Gateway_SlotAvailable_di" bpmnElement="Gateway_SlotAvailable" isMarkerVisible="true"><dc:Bounds x="380" y="173" width="50" height="50"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Task_BookSlot_di" bpmnElement="Task_BookSlot"><dc:Bounds x="490" y="75" width="150" height="80"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Call_Confirmation_di" bpmnElement="Call_Confirmation"><dc:Bounds x="700" y="75" width="180" height="80"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Catch_AppointmentCompleted_di" bpmnElement="Catch_AppointmentCompleted"><dc:Bounds x="940" y="97" width="36" height="36"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="End_AppointmentCompleted_di" bpmnElement="End_AppointmentCompleted"><dc:Bounds x="1050" y="97" width="36" height="36"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Call_SlotFull_di" bpmnElement="Call_SlotFull"><dc:Bounds x="500" y="270" width="180" height="80"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="End_SlotUnavailable_di" bpmnElement="End_SlotUnavailable"><dc:Bounds x="750" y="292" width="36" height="36"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="EventSub_Cancellation_di" bpmnElement="EventSub_Cancellation" isExpanded="true"><dc:Bounds x="180" y="430" width="820" height="190"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Start_Cancellation_di" bpmnElement="Start_Cancellation"><dc:Bounds x="220" y="505" width="36" height="36"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Task_ReleaseSlot_di" bpmnElement="Task_ReleaseSlot"><dc:Bounds x="320" y="483" width="150" height="80"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Call_Cancellation_di" bpmnElement="Call_Cancellation"><dc:Bounds x="550" y="483" width="190" height="80"/></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="End_CancellationHandled_di" bpmnElement="End_CancellationHandled"><dc:Bounds x="830" y="505" width="36" height="36"/></bpmndi:BPMNShape>
   <bpmndi:BPMNEdge id="Flow_Start_CheckSlot_di" bpmnElement="Flow_Start_CheckSlot"><di:waypoint x="136" y="198"/><di:waypoint x="180" y="198"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Check_Gateway_di" bpmnElement="Flow_Check_Gateway"><di:waypoint x="330" y="198"/><di:waypoint x="380" y="198"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_SlotAvailable_di" bpmnElement="Flow_SlotAvailable"><di:waypoint x="405" y="173"/><di:waypoint x="405" y="115"/><di:waypoint x="490" y="115"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_SlotFull_di" bpmnElement="Flow_SlotFull"><di:waypoint x="405" y="223"/><di:waypoint x="405" y="310"/><di:waypoint x="500" y="310"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Book_Confirmation_di" bpmnElement="Flow_Book_Confirmation"><di:waypoint x="640" y="115"/><di:waypoint x="700" y="115"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Confirmation_Wait_di" bpmnElement="Flow_Confirmation_Wait"><di:waypoint x="880" y="115"/><di:waypoint x="940" y="115"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Wait_End_di" bpmnElement="Flow_Wait_End"><di:waypoint x="976" y="115"/><di:waypoint x="1050" y="115"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Full_End_di" bpmnElement="Flow_Full_End"><di:waypoint x="680" y="310"/><di:waypoint x="750" y="310"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Cancel_Release_di" bpmnElement="Flow_Cancel_Release"><di:waypoint x="256" y="523"/><di:waypoint x="320" y="523"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Release_Notify_di" bpmnElement="Flow_Release_Notify"><di:waypoint x="470" y="523"/><di:waypoint x="550" y="523"/></bpmndi:BPMNEdge>
   <bpmndi:BPMNEdge id="Flow_Cancel_End_di" bpmnElement="Flow_Cancel_End"><di:waypoint x="740" y="523"/><di:waypoint x="830" y="523"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane>
 </bpmndi:BPMNDiagram>
</bpmn:definitions>
